# =============================================================================
# Visitflow — Production environment template (Laravel API)
# =============================================================================
# Copy to `.env` on the production host (or set the equivalent variables in your
# platform's dashboard) and fill in every value marked CHANGE_ME.
#
#   cp backend/.env.production.example backend/.env
#   php artisan key:generate
#
# Never commit the real `.env`.
# =============================================================================

APP_NAME="Visitflow"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC

# Public HTTPS URL of this API (no trailing slash). Used for generated URLs.
APP_URL=https://your-production-api-domain

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database ---------------------------------------------------------------
# Point at the managed MySQL instance (host, not 127.0.0.1) with TLS if offered.
DB_CONNECTION=mysql
DB_HOST=CHANGE_ME
DB_PORT=3306
DB_DATABASE=visitflow
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_COLLATION=utf8mb4_unicode_ci

# --- Sessions ---------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Set to your API host, and force secure cookies behind HTTPS.
SESSION_DOMAIN=your-production-api-domain
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- Sanctum (token auth) ---------------------------------------------------
# The SPA authenticates with Bearer tokens, so stateful (cookie) domains are
# optional. Add the Vercel origin here only if you enable cookie-based SPA auth.
SANCTUM_STATEFUL_DOMAINS=your-frontend-domain.vercel.app

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed browser origins for the deployed frontend.
# Do NOT leave this as `*` in production.
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app

BROADCAST_CONNECTION=log

# --- Media storage ----------------------------------------------------------
# Uploaded photos must survive redeploys. Either:
#   (a) object storage  -> FILESYSTEM_DISK=s3 and fill the AWS_* block below, or
#   (b) a persistent volume mounted at storage/app (FILESYSTEM_DISK=local).
# Ephemeral container filesystems WILL lose uploads on restart/redeploy.
FILESYSTEM_DISK=local

# Cloudinary signed image storage. Set enabled=true after filling all values.
CLOUDINARY_ENABLED=true
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
CLOUDINARY_FOLDER=visitflow/places

# --- Queue & cache ----------------------------------------------------------
# `database` works out of the box; `redis` is recommended under load.
# Run a worker in production: php artisan queue:work --tries=3
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=visitflow

# --- Mail -------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@your-production-api-domain"
MAIL_FROM_NAME="${APP_NAME}"

# --- Object storage (only needed when FILESYSTEM_DISK=s3) -------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
