# Visitflow frontend — production environment template
# ---------------------------------------------------------------------------
# Vite inlines VITE_* variables at BUILD time (they are NOT read at runtime),
# so every value here must be set in the Vercel project's Environment
# Variables before the production build runs.
#
# Copy this file to `.env.production` for a self-hosted production build, or
# set these keys in the Vercel dashboard:
#   Project → Settings → Environment Variables → Production
#
# ---------------------------------------------------------------------------

# Base URL of the deployed Laravel API, including the trailing `/api`.
# Must be publicly reachable over HTTPS.
# Example: https://visitflow-api.up.railway.app/api
VITE_API_URL=https://your-production-api-domain/api
